{
  "name": "neodio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx scripts/migrate-db.ts",
    "db:push-to-prod": "set -a && . ./.env.neon.local && set +a && tsx scripts/migrate-db.ts",
    "db:sync-to-prod": "set -a && . ./.env.local && SOURCE_POSTGRES_URL=$POSTGRES_URL && . ./.env.neon.local && set +a && tsx scripts/sync-local-to-remote.ts",
    "db:push-runs-to-prod": "set -a && . ./.env.local && SOURCE_POSTGRES_URL=$POSTGRES_URL && . ./.env.neon.local && set +a && tsx scripts/push-collected-runs.ts",
    "db:sync-org-to-prod": "set -a && . ./.env.local && SOURCE_POSTGRES_URL=$POSTGRES_URL && . ./.env.neon.local && set +a && tsx scripts/sync-org-to-remote.ts",
    "test:db": "node scripts/test-pg-harness.mjs",
    "test:unit": "tsx --test src/lib/backend/youtube.test.ts src/lib/backend/aio/judge.test.ts src/lib/backend/aio/metrics.test.ts src/lib/youtubeSocial.test.ts src/lib/slug.test.ts src/lib/tenantRouting.test.ts src/lib/backend/llm/gemini.test.ts",
    "collect:naver-ai": "node scripts/collect-naver-ai.mjs",
    "open:naver-ai-chrome": "node scripts/open-naver-ai-chrome.mjs",
    "collect:google-ai": "node scripts/collect-google-ai.mjs",
    "collect:google-aio": "node scripts/collect-google-aio.mjs",
    "collect:scheduled": "tsx scripts/collect-scheduled.ts",
    "collect:aio": "tsx scripts/collect-aio.ts",
    "collect:llm": "tsx scripts/collect-llm.ts",
    "collector": "tsx collector/agent.ts",
    "collector:build": "node collector/build.mjs",
    "collector:upload": "scripts/upload-collector.sh",
    "open:google-ai-chrome": "node scripts/open-google-ai-chrome.mjs",
    "parse:naver-ai-html": "python3 scripts/parse_naver_ai_html.py",
    "process:raw": "tsx scripts/process-raw.ts",
    "crawl:sitemap": "node scripts/crawl-sitemap.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
